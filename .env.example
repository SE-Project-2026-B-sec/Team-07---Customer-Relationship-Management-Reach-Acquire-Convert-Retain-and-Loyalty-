# Copy this file to .env and change the secrets before running.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=60m
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Password given to every seeded demo account (local/dev only)
SEED_PASSWORD=Password@123

